/* 点单页样式 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* 分类导航 */
.category-bar {
  display: flex;
  background: #fff;
  padding: 8px 12px;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.category-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 6px 16px;
  margin-right: 8px;
  border-radius: 10px;
  transition: all 0.2s;
}

.category-tab.active {
  background: #FFF3ED;
}

.category-tab .icon {
  font-size: 24px;
  margin-bottom: 2px;
}

.category-tab .name {
  font-size: 13px;
  color: #666;
}

.category-tab.active .name {
  color: #FF6B35;
  font-weight: 500;
}

/* 菜品列表 */
.dish-list {
  flex: 1;
  padding: 12px 16px;
}

.category-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dish-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
}

.dish-desc {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.dish-price {
  font-size: 18px;
  color: #FF6B35;
  font-weight: 600;
  margin-top: 6px;
}

.dish-add {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn {
  width: 36px;
  height: 36px;
  line-height: 36px;
  text-align: center;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  font-size: 22px;
  font-weight: 500;
}

/* 底部购物车条 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #333;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  z-index: 100;
}

.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-icon {
  position: relative;
  font-size: 28px;
  margin-right: 10px;
}

.cart-badge {
  position: absolute;
  top: -6px;
  right: -10px;
  background: #FF6B35;
  color: #fff;
  font-size: 11px;
  min-width: 18px;
  height: 18px;
  line-height: 18px;
  text-align: center;
  border-radius: 9px;
  padding: 0 4px;
}

.cart-total {
  color: #fff;
  font-size: 18px;
  font-weight: 600;
}

.cart-submit {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  color: #fff;
  padding: 10px 28px;
  border-radius: 22px;
  font-size: 16px;
  font-weight: 500;
}

/* 购物车弹窗 */
.cart-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 90;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.cart-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.cart-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 20px 20px 0 0;
  z-index: 95;
  transform: translateY(100%);
  transition: transform 0.3s;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(60px + env(safe-area-inset-bottom));
}

.cart-panel.show {
  transform: translateY(0);
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-title {
  font-size: 18px;
  font-weight: 600;
}

.cart-clear {
  font-size: 14px;
  color: #999;
}

.cart-items {
  flex: 1;
  padding: 8px 20px;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.cart-item-info {
  display: flex;
  flex-direction: column;
}

.cart-item-name {
  font-size: 15px;
  color: #333;
}

.cart-item-price {
  font-size: 13px;
  color: #999;
  margin-top: 2px;
}

.cart-item-qty {
  display: flex;
  align-items: center;
  gap: 10px;
}

.qty-btn {
  width: 28px;
  height: 28px;
  line-height: 28px;
  text-align: center;
  border: 1rpx solid #ddd;
  border-radius: 14px;
  font-size: 16px;
  color: #666;
}

.qty-num {
  font-size: 16px;
  font-weight: 500;
  min-width: 24px;
  text-align: center;
}

.cart-remark {
  padding: 12px 20px;
  border-top: 1rpx solid #f0f0f0;
}

.cart-remark input {
  background: #f5f5f5;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 14px;
  width: 100%;
}

.loading {
  text-align: center;
  padding: 40px;
  color: #999;
}
