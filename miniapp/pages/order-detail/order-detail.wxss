.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 20px;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.detail-meta {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: #999;
}

.detail-remark {
  margin-top: 8px;
  padding: 8px 12px;
  background: #FFF8F0;
  border-radius: 8px;
  font-size: 13px;
  color: #666;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12px;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.item-name {
  font-size: 15px;
  color: #333;
}

.item-qty {
  font-size: 13px;
  color: #999;
}

.item-price {
  font-size: 15px;
  color: #333;
  font-weight: 500;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12px;
  font-size: 15px;
  color: #333;
}

.total-price {
  font-size: 20px;
  color: #FF6B35;
  font-weight: 700;
}

/* 操作按钮 */
.action-card {
  margin-top: 0;
}

.action-btns {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1;
  min-width: 120px;
  padding: 10px 16px;
  border-radius: 10px;
  border: none;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
}

.action-btn.cooking {
  background: #E3F2FD;
  color: #2196F3;
}

.action-btn.done {
  background: #E8F5E9;
  color: #4CAF50;
}

.action-btn.cancel {
  background: #FBE9E7;
  color: #F44336;
}
