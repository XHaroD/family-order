.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 20px;
}

/* 登录 */
.login-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 32px 40px;
}

.login-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.login-title {
  font-size: 24px;
  font-weight: 700;
  color: #333;
  margin-bottom: 8px;
}

.login-desc {
  font-size: 14px;
  color: #999;
  margin-bottom: 32px;
}

.login-input {
  width: 80%;
  padding: 14px 16px;
  border: 2rpx solid #eee;
  border-radius: 12px;
  font-size: 16px;
  text-align: center;
  margin-bottom: 20px;
}

.login-btn {
  width: 80%;
}

/* 已登录 */
.profile-header {
  display: flex;
  align-items: center;
  gap: 16px;
}

.avatar {
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  color: #fff;
  text-align: center;
  line-height: 56px;
  font-size: 24px;
  font-weight: 600;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 20px;
  font-weight: 600;
  color: #333;
}

.profile-role {
  font-size: 13px;
  color: #999;
  margin-top: 2px;
}

/* 统计 */
.stats-card {
  display: flex;
  justify-content: space-around;
  padding: 20px 16px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 22px;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

/* 菜单 */
.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 20px;
  margin-right: 12px;
}

.menu-text {
  flex: 1;
  font-size: 15px;
  color: #333;
}

.menu-arrow {
  font-size: 20px;
  color: #ccc;
}

/* 家庭信息 */
.family-info {
  margin-top: 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 14px;
  color: #666;
  padding: 8px 0;
}

.family-code {
  font-family: monospace;
  font-size: 14px;
  color: #FF6B35;
  font-weight: 600;
}
