<view class="page">
  <!-- 未登录 -->
  <view class="login-box" wx:if="{{!loggedIn}}">
    <view class="login-icon">👤</view>
    <view class="login-title">家庭点单</view>
    <view class="login-desc">输入昵称即可加入家庭</view>
    <input class="login-input" placeholder="请输入你的昵称" bindinput="onInputNickname" />
    <button class="btn-primary login-btn" bindtap="login">进入</button>
  </view>

  <!-- 已登录 -->
  <view class="profile" wx:else>
    <view class="card profile-header">
      <view class="avatar">{{member.nickname.charAt(0)}}</view>
      <view class="profile-info">
        <text class="profile-name">{{member.nickname}}</text>
        <text class="profile-role">
          {{member.role === 'admin' ? '管理员' : member.role === 'chef' ? '大厨' : '家庭成员'}}
        </text>
      </view>
    </view>

    <view class="card stats-card" wx:if="{{stats}}">
      <view class="stat-item">
        <text class="stat-num">{{stats.order_count}}</text>
        <text class="stat-label">总订单</text>
      </view>
      <view class="stat-item">
        <text class="stat-num" style="color:#FF6B35">¥{{stats.total_spent}}</text>
        <text class="stat-label">总消费</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.completed_orders}}</text>
        <text class="stat-label">已完成</text>
      </view>
    </view>

    <view class="card menu-list">
      <view class="menu-item" wx:if="{{member.role === 'admin' || member.role === 'chef'}}" bindtap="goAdmin">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">管理后台</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="logout">
        <text class="menu-icon">🚪</text>
        <text class="menu-text" style="color:#F44336">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="family-info card">
      <text class="section-title">家庭信息</text>
      <view class="info-row">
        <text>家庭码</text>
        <text class="family-code">{{member.familyCode}}</text>
      </view>
    </view>
  </view>
</view>
