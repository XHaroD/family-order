.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.filter-bar {
  display: flex;
  background: #fff;
  padding: 10px 16px;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-tab {
  display: inline-block;
  padding: 6px 16px;
  margin-right: 8px;
  border-radius: 16px;
  font-size: 13px;
  color: #666;
  background: #f5f5f5;
}

.filter-tab.active {
  background: #FF6B35;
  color: #fff;
  font-weight: 500;
}

.order-list {
  padding: 12px 16px;
}

.order-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.order-no {
  font-size: 13px;
  color: #999;
  font-family: monospace;
}

.order-body {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

.order-member {
  font-size: 14px;
  color: #333;
}

.order-time {
  font-size: 12px;
  color: #bbb;
}

.order-footer {
  display: flex;
  justify-content: space-between;
}

.order-count {
  font-size: 13px;
  color: #999;
}

.order-total {
  font-size: 18px;
  color: #FF6B35;
  font-weight: 600;
}

.order-remark {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1rpx solid #f0f0f0;
  font-size: 13px;
  color: #999;
}
