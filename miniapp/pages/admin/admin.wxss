.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.admin-tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.admin-tab {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 14px;
  color: #666;
  border-bottom: 2px solid transparent;
}

.admin-tab.active {
  color: #FF6B35;
  font-weight: 500;
  border-bottom-color: #FF6B35;
}

.tab-content {
  padding: 12px 16px;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 10px;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  font-size: 15px;
  font-weight: 500;
}

.order-info {
  font-size: 13px;
  color: #999;
  margin-bottom: 10px;
}

.order-actions {
  display: flex;
  gap: 8px;
}

.action-btn.mini {
  padding: 4px 12px;
  font-size: 12px;
  border: none;
  border-radius: 6px;
  min-width: auto;
  line-height: 1.8;
}

.action-btn.mini::after {
  border: none;
}

/* 添加按钮 */
.add-btn-bar {
  margin-bottom: 12px;
}

.add-dish-btn {
  width: 100%;
  text-align: center;
}

/* 菜品/分类卡片 */
.dish-card {
  background: #fff;
  border-radius: 10px;
  padding: 12px 16px;
  margin-bottom: 8px;
}

.dish-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.dish-meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #999;
}

.dish-meta .on { color: #4CAF50; }
.dish-meta .off { color: #F44336; }

.dish-actions-row {
  margin-top: 6px;
  text-align: right;
}

.del-btn {
  font-size: 12px;
  color: #F44336;
  padding: 4px 8px;
}

.dish-count {
  font-size: 13px;
  color: #999;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 20px 20px 0 0;
  padding: 24px 20px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
  z-index: 210;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.modal-panel.show {
  transform: translateY(0);
}

.modal-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 16px;
  text-align: center;
}

.modal-input {
  width: 100%;
  padding: 12px 14px;
  border: 1rpx solid #eee;
  border-radius: 10px;
  font-size: 15px;
  margin-bottom: 12px;
}

.modal-label {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.cat-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.cat-option {
  padding: 6px 14px;
  border: 1rpx solid #eee;
  border-radius: 16px;
  font-size: 13px;
  color: #666;
}

.cat-option.active {
  background: #FFF3ED;
  border-color: #FF6B35;
  color: #FF6B35;
}

.modal-btns {
  display: flex;
  gap: 12px;
  margin-top: 8px;
}

.modal-btn {
  flex: 1;
  padding: 12px;
  border: none;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  text-align: center;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #FF6B35;
  color: #fff;
}
