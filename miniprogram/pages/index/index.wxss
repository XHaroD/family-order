/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.user-bar {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-name {
  color: #fff;
  font-size: 28rpx;
}

.change-btn {
  color: #fff;
  font-size: 24rpx;
  background: rgba(255,255,255,0.3);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.category-tabs {
  white-space: nowrap;
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.tab {
  display: inline-block;
  padding: 16rpx 30rpx;
  margin: 0 10rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
}

.tab.active {
  color: #fff;
  background: #ff6b6b;
}

.menu-list {
  padding: 20rpx;
}

.menu-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.dish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.dish-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.dish-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.dish-status.on {
  color: #52c41a;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.dish-status.off {
  color: #ff4d4f;
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.dish-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-category {
  font-size: 24rpx;
  color: #666;
  background: #f0f0f0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.add-btn {
  padding: 14rpx 30rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  border-radius: 30rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.cart-float {
  position: fixed;
  bottom: 180rpx;
  right: 30rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(255,107,107,0.4);
  z-index: 100;
}

.cart-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}

.cart-count {
  background: #fff;
  color: #ff6b6b;
  font-size: 24rpx;
  font-weight: bold;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 36rpx;
  margin-right: 10rpx;
}

.cart-text {
  color: #fff;
  font-size: 28rpx;
}

/* 昵称弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.modal-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  text-align: center;
}
