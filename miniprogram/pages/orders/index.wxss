/* pages/order/index.wxss */
.dish-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.dish-name {
  font-size: 36rpx;
  font-weight: bold;
}

.dish-price {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.quantity-control {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
  font-size: 28rpx;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #f0f0f0;
  border-radius: 50%;
  margin: 0 20rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.quantity-num {
  font-size: 32rpx;
  font-weight: bold;
  margin: 0 30rpx;
}

.total-price {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  border-top: 1rpx solid #eee;
}

.price-value {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.form-section {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.form-input, .form-textarea {
  width: 100%;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  height: 200rpx;
}

.submit-btn {
  margin-top: 40rpx;
  background: #ff6b6b;
  color: white;
  font-size: 32rpx;
  border-radius: 12rpx;
}

.submit-btn[disabled] {
  background: #ccc;
}

.bottom-space {
  height: 120rpx;
}
