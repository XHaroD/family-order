<!--pages/orders/orders.wxml-->
<view class="container">
  <!-- 状态筛选 -->
  <view class="status-tabs">
    <view 
      class="tab {{activeStatus === '' ? 'active' : ''}}" 
      bindtap="onStatusChange"
      data-status=""
    >全部</view>
    <view 
      class="tab {{activeStatus === 'pending' ? 'active' : ''}}" 
      bindtap="onStatusChange"
      data-status="pending"
    >待处理</view>
    <view 
      class="tab {{activeStatus === 'cooking' ? 'active' : ''}}" 
      bindtap="onStatusChange"
      data-status="cooking"
    >制作中</view>
    <view 
      class="tab {{activeStatus === 'done' ? 'active' : ''}}" 
      bindtap="onStatusChange"
      data-status="done"
    >已完成</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-header">
        <text class="order-no">订单号：{{item.order_no}}</text>
        <text class="order-status {{item.status}}">
          {{item.status === 'pending' ? '待处理' : 
            item.status === 'cooking' ? '制作中' : 
            item.status === 'done' ? '已完成' : '已取消'}}
        </text>
      </view>
      
      <view class="order-member">
        <text>👤 {{item.member_name}}</text>
      </view>

      <view class="order-items">
        <view class="item" wx:for="{{item.items}}" wx:for-item="dish" wx:key="dish_id">
          <text class="item-name">{{dish.dish_name}}</text>
          <text class="item-qty">x{{dish.quantity}}</text>
          <text class="item-price">¥{{dish.unit_price}}</text>
        </view>
      </view>

      <view class="order-remark" wx:if="{{item.remark}}">
        <text>📝 {{item.remark}}</text>
      </view>

      <view class="order-footer">
        <text class="order-time">{{item.created_at}}</text>
        <text class="order-total">合计：¥{{item.total_price}}</text>
      </view>

      <view class="order-actions" wx:if="{{item.status !== 'done' && item.status !== 'cancelled'}}">
        <view class="action-btn cooking" wx:if="{{item.status === 'pending'}}" 
              bindtap="updateStatus" data-id="{{item.id}}" data-status="cooking">
          开始制作
        </view>
        <view class="action-btn done" wx:if="{{item.status === 'cooking'}}" 
              bindtap="updateStatus" data-id="{{item.id}}" data-status="done">
          完成
        </view>
        <view class="action-btn cancel" 
              bindtap="updateStatus" data-id="{{item.id}}" data-status="cancelled">
          取消
        </view>
      </view>
    </view>

    <view wx:if="{{orders.length === 0}}" class="empty-tip">暂无订单</view>
  </view>
</view>
