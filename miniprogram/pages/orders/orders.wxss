/* pages/orders/orders.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.status-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
  margin: 0 8rpx;
}

.tab.active {
  color: #fff;
  background: #ff6b6b;
}

.order-list {
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.order-status.pending {
  color: #faad14;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
}

.order-status.cooking {
  color: #1890ff;
  background: #e6f7ff;
  border: 1rpx solid #91d5ff;
}

.order-status.done {
  color: #52c41a;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.order-status.cancelled {
  color: #ff4d4f;
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
}

.order-member {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.order-items {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.item-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.item-qty {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.order-remark {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #fffbe6;
  border-radius: 8rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  padding: 16rpx 30rpx;
  margin-left: 20rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.action-btn.cooking {
  color: #1890ff;
  background: #e6f7ff;
  border: 1rpx solid #91d5ff;
}

.action-btn.done {
  color: #fff;
  background: #52c41a;
}

.action-btn.cancel {
  color: #ff4d4f;
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
