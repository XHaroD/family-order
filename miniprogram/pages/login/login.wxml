<!--pages/login/login.wxml-->
<view class="container">
  <view class="login-box">
    <view class="logo">🍽️</view>
    <view class="title">家庭点单系统</view>
    <view class="subtitle">输入昵称开始点餐</view>
    
    <view class="input-group">
      <input 
        class="input" 
        placeholder="请输入您的昵称" 
        value="{{nickname}}"
        bindinput="onInput"
        focus="{{true}}"
      />
    </view>
    
    <button class="login-btn" bindtap="login" disabled="{{!nickname.trim()}}">
      进入点餐
    </button>
  </view>
</view>
